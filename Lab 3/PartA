import cv2
import numpy as np


def detectLine(frame):
    """
    Process the given frame to detect and track the center of a white line.

    Returns:
        lineCenter: Number between [-1, 1] representing line position.
        newFrame: Processed frame with rectangle and center marked.
    """

    # Get dimensions of the frame
    height, width = frame.shape[:2]

    # Convert image from BGR to HSV
    hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)

    # Define range for detecting white pixels
    lower_white = np.array([0, 0, 180])
    upper_white = np.array([179, 70, 255])

    # Create a mask to isolate white regions
    mask = cv2.inRange(hsv, lower_white, upper_white)

    # Find contours of white regions
    contours, _ = cv2.findContours(
        mask,
        cv2.RETR_EXTERNAL,
        cv2.CHAIN_APPROX_SIMPLE
    )

    # Copy original frame for drawing
    newFrame = frame.copy()

    # Default value when no line is detected
    lineCenter = None

    if contours:

        # Find largest white region
        largest = max(contours, key=cv2.contourArea)

        # Ignore small white objects or noise
        if cv2.contourArea(largest) > 500:

            # Get bounding rectangle
            x, y, w, h = cv2.boundingRect(largest)

            # Draw rectangle around white line
            cv2.rectangle(
                newFrame,
                (x, y),
                (x + w, y + h),
                (0, 255, 0), 2
            )

            # Calculate center of detected white region
            M = cv2.moments(largest)

            if M["m00"] != 0:

                cx = int(M["m10"] / M["m00"])
                cy = int(M["m01"] / M["m00"])

                # Draw circle at center
                cv2.circle(
                    newFrame,(cx, cy),6,
                    (0, 0, 255),-1
                )

                # Normalize center position between -1 and 1
                lineCenter = (cx - width / 2) / (width / 2)

                # Display center position on frame
                cv2.putText(
                    newFrame,
                    f"Line Center: {lineCenter:.2f}",
                    (20, 40),
                    cv2.FONT_HERSHEY_SIMPLEX,
                    0.7,(255, 0, 0),2
                )

    return lineCenter, newFrame


def main():

    # Open webcam
    cam = cv2.VideoCapture(0)

    if not cam.isOpened():
        print("Error: Could not open webcam.")
        return

    while cam.isOpened():

        ret, frame = cam.read()

        if not ret:
            break

        # Call line detection function
        lineCenter, newFrame = detectLine(frame)

        # Print detected center
        print("Line Center:", lineCenter)

        # Show processed webcam image
        cv2.imshow("Line Tracking", newFrame)

        # Press Q to exit
        if cv2.waitKey(1) & 0xFF == ord('q'):
            break

    cam.release()
    cv2.destroyAllWindows()


if __name__ == "__main__":
    main()
